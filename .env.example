# ─────────────────────────────────────────────────────────────────────────────
# CrimeLens — all configuration & credentials in ONE place.
#
# Copy this file to `.env` and fill in real values:   cp .env.example .env
# `.env` is gitignored and must NEVER be committed.
#
# The app boots fine with the defaults below (Docker uses them automatically),
# so you only need a real `.env` to turn on real email sending.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL + PostGIS) ──────────────────────────────────────────
# Read by both the `db` and `app` containers in docker-compose.
POSTGRES_DB=crimelens
POSTGRES_USER=crimelens
POSTGRES_PASSWORD=crimelens

# ── App ──────────────────────────────────────────────────────────────────────
# Secret used to sign session cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Port the server listens on (also the published port).
PORT=3000

# ── Email / sign-in codes (Gmail SMTP) ───────────────────────────────────────
# MAIL_MODE=console  → prints the 6-digit sign-in code to the server logs
#                      (default; no credentials needed — fine for grading/demo)
# MAIL_MODE=gmail    → sends the code by real email via Gmail SMTP
MAIL_MODE=console

# Required ONLY when MAIL_MODE=gmail:
#   GMAIL_FROM         = the Gmail address that sends the codes
#   GMAIL_APP_PASSWORD = a 16-character Google "App Password" (NOT your normal
#                        Gmail password). Create at:
#                        Google Account → Security → 2-Step Verification → App passwords
# ⚠️ This app password is a real secret. It lives only in the team's private
#    `.env` and is intentionally not shared in the repo.
GMAIL_FROM=
GMAIL_APP_PASSWORD=
